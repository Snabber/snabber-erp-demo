# Endereço da Snabber.
SNABBER_BASE_URL=https://snabber.com.br

# Chave da org (snb_live_...), criada em https://snabber.com.br/org › Chave da Org.
# Fica só no servidor deste ERP; nunca no navegador nem no git.
SNABBER_ORG_KEY=

# Segredo do webhook (whsec_...), gerado em /org › Webhook. Usado para validar a assinatura dos eventos.
SNABBER_WEBHOOK_SECRET=

# Endereço público https deste ERP. Vai no redirect_url dos links de conexão e é a base da URL do webhook.
# Rodando na sua máquina, use um túnel (ver README), por exemplo https://xxxx.trycloudflare.com
APP_BASE_URL=

# Chave para cifrar as chaves de API dos clientes guardadas em .data/db.json.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
